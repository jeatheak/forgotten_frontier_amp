Meta.DisplayName=The Forgotten Frontier
Meta.Description=The Forgotten Frontier co-op dedicated server (FFServer)
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=Thomas van den Heuvel
Meta.URL=https://github.com/jeatheak/forgotten_frontier_amp
Meta.DisplayImageSource=none:
Meta.EndpointURIFormat=
Meta.ConfigManifest=forgottenfrontierconfig.json
Meta.MetaConfigManifest=forgottenfrontiermetaconfig.json
Meta.ConfigRoot=forgottenfrontier.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.Prerequisites=[]
Meta.ConfigReleaseState=NotSpecified
Meta.AppConfigId=09bdc257-0453-414c-9961-720e69048731
Meta.ConfigVersion=9
Meta.ReleaseNotes=Game and server v0.32.0 (real hands; includes v0.31.0 in good stride). Server: no changes besides the version; no settings changed (game and server versions must match). Game: new walking, running, sprinting and sneaking with planted feet, relaxed arms and new chop and mine swings; animations play at their proper pace; hands with finger bones that grip what they hold; a rebuilt iron helmet and better hips. From the playtest: a bed needs a sheltered room (roof and walls) to sleep in, the tanning rack may stand on a plank floor, and creatures no longer appear in water.
Meta.AppIsMultiIPAware=False
App.DisplayName=The Forgotten Frontier
App.RootDir=./forgottenfrontier/
App.BaseDirectory=./forgottenfrontier/
App.ExecutableWin=FFServer.exe
App.ExecutableLinux=FFServer
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-port {{$GamePort}} -bind {{$ApplicationIPBinding}} -name "{{ServerName}}" -password "{{ServerPassword}}" -maxplayers {{$MaxUsers}} -world "{{WorldName}}" -seed {{WorldSeed}} -difficulty {{Difficulty}} -autosave {{AutosaveMinutes}} -backups {{Backups}} -backupminutes {{BackupMinutes}} -moderators "{{Moderators}}" -motd "{{WelcomeMessage}}" -savedir "{{$FullBaseDir}}saves" -config "{{$FullBaseDir}}server.json"
App.AppSettings={}
App.EnvironmentVariables={"DOTNET_gcServer":"0"}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitTimeout=30
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[forgottenfrontierports.json]
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=
App.UniversalSleepSteamQueryPortRef=
App.MaxUsers=4
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[forgottenfrontierupdates.json]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=NotMods
App.SteamForceLoginPrompt=False
App.RapidStartup=True
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^\[\d\d:\d\d:\d\d\] \[FF\] Server ready on port \d+.*$
Console.UserJoinRegex=^\[\d\d:\d\d:\d\d\] \[FF\] Player joined: (?<username>.+?) \(id (?<userid>\d+)\) from (?<endpoint>.+)$
Console.UserLeaveRegex=^\[\d\d:\d\d:\d\d\] \[FF\] Player left: (?<username>.+?) \(id (?<userid>\d+)\).*$
Console.UserChatRegex=^\[\d\d:\d\d:\d\d\] \[FF\] <(?<username>.+?)> (?<message>.+)$
Console.UpdateAvailableRegex=
Console.MetricsRegex=
Console.ServerInfoRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={"Kick": "kick {{userid}}", "Ban": "ban {{userid}}", "Make Moderator": "mod {{userid}}", "Remove Moderator": "unmod {{userid}}"}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
